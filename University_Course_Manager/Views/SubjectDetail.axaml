<UserControl
    x:Class="University_Course_Manager.Views.SubjectDetail"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:University_Course_Manager.ViewModels"
    xmlns:vm="[vm ]using:University_Course_Manager.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewModels:SubjectDetailViewModel"
    mc:Ignorable="d">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock FontSize="24" Text="{Binding Subject.Name}" />
        <TextBlock
            Margin="0,10"
            FontSize="16"
            Text="{Binding Subject.Description}" />
        <Button
            Width="100"
            Command="{Binding BackCommand}"
            Content="Back" />
    </StackPanel>
</UserControl>
