<UserControl
    x:Class="University_Course_Manager.Views.TaughtSubjects"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:University_Course_Manager.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:TaughtSubjectsViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto, *">
        <!--  Header  -->
        <TextBlock
            Grid.Row="0"
            Margin="40,50,0,0"
            FontSize="24"
            Foreground="#222222"
            Text="My Taught Courses" />

        <!--  Course Grid  -->
        <ItemsControl
            Grid.Row="1"
            Margin="40,10,50,30"
            ItemsSource="{Binding TaughtSubjectsList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel
                        Width="200"
                        Height="400"
                        Margin="0,50,50,50"
                        HorizontalAlignment="Left">
                        <Rectangle
                            Width="200"
                            Height="200"
                            Fill="{Binding Color}" />
                        <TextBlock
                            Margin="5"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#222222"
                            Text="{Binding Name}" />
                        <TextBlock
                            Margin="5"
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Foreground="#555555"
                            Text="{Binding Description}" />
                        <StackPanel Orientation="Horizontal">
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="#f0f0f0"
                                Command="{Binding $parent[ItemsControl].((vm:TaughtSubjectsViewModel)DataContext).SelectSubjectCommand}"
                                CommandParameter="{Binding}"
                                Content="View"
                                Foreground="#222222" />
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="#f0f0f0"
                                Command="{Binding $parent[ItemsControl].((vm:TaughtSubjectsViewModel)DataContext).DeleteSubjectCommand}"
                                CommandParameter="{Binding}"
                                Content="Delete"
                                Foreground="#222222" />
                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
