<UserControl
    x:Class="University_Course_Manager.Views.CreateSubject"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:University_Course_Manager.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:CreateSubjectViewModel"
    mc:Ignorable="d">
    <StackPanel Width="400" Spacing="12">
        <TextBlock
            Margin="0,0,0,10"
            FontSize="24"
            FontWeight="Bold"
            Text="Create New Course" />

        <TextBlock Text="Course Name" />
        <TextBox Text="{Binding SubjectName}" Watermark="Enter course name" />

        <TextBlock Text="Description" />
        <TextBox
            Height="80"
            AcceptsReturn="True"
            Text="{Binding Description}"
            Watermark="Short description..." />

        <TextBlock Text="Color" />
        <ComboBox ItemsSource="{Binding AvailableColors}" SelectedItem="{Binding SelectedColor}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Rectangle
                            Width="16"
                            Height="16"
                            Fill="{Binding}"
                            Stroke="Black" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button
            Margin="0,20,0,0"
            Command="{Binding CreateSubjectCommand}"
            Content="Create Course" />
    </StackPanel>
</UserControl>
